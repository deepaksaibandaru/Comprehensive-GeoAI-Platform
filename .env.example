# =========================================================================
# Braein.ai - BSDI / IGA deployment environment
# =========================================================================
# Copy to ".env" beside run_server.py and fill in. run_server.py loads it
# with stdlib parsing (no python-dotenv); anything already set in the real
# environment WINS, so IIS <environmentVariables> and service units stay
# authoritative.
#
# Every variable below is consumed by deployment_config.py or auth.py and
# by nothing else. That is deliberate: deployment_config.py is the single
# surface the NCSC review is run from.
#
# .env CONTAINS SECRETS. Do not commit it. It must not be served: it sits
# beside the application, not under static/, and the shipped web.config
# denies it explicitly.
#
# run_server.py REFUSES to start when HOST is not loopback and either
# SESSION_SECRET is unset or SESSION_COOKIE_SECURE is off.
# =========================================================================


# -------------------------------------------------------------------------
# 1. SESSIONS AND LOGIN  (auth.py)  - REQUIRED off loopback
# -------------------------------------------------------------------------

# Signs the session cookie. Unset means a key generated per process: every
# restart signs every user out, and two workers reject each other's
# cookies. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Marks the session cookie Secure, so the browser will not send it over
# plain HTTP. Must be true behind IIS/TLS. Fatal if off and HOST is not
# loopback.
SESSION_COOKIE_SECURE=true

# Session lifetime in hours, and the cookie name.
SESSION_HOURS=8
SESSION_COOKIE=geoai_session

# Login throttle: lock a username+address pair after this many failures.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=300

# PBKDF2 cost for local passwords. 600000 is the OWASP 2023 SHA-256 figure.
PBKDF2_ITERATIONS=600000

# Where local accounts live. Keep it off any web-served path.
# USERS_FILE=D:\BSDI\geoai\users.json


# -------------------------------------------------------------------------
# 2. IDENTITY BACKEND  (auth.py)
# -------------------------------------------------------------------------

# local  = users.json, PBKDF2 hashes. Demo and standalone.
# arcgis = ArcGIS Portal generateToken + group membership. IGA production.
# both   = try Portal, fall back to local if the Portal is unreachable.
AUTH_BACKEND=local

# Portal to authenticate against when AUTH_BACKEND is arcgis or both.
ARCGIS_PORTAL_URL=
# Referer sent with generateToken; must match what the Portal expects.
ARCGIS_REFERER=https://geoai.bsdi.gov.bh
# Never set this to false outside a lab: it disables TLS verification of
# the Portal, which is the thing proving the user's password went to IGA.
ARCGIS_VERIFY_TLS=true

# Portal GROUP -> role. Roles come from group membership, not ArcGIS org
# roles, which are too coarse to express "may spend GPU budget".
# Roles: labeler | data_scientist | reviewer | admin
# ROLE_GROUPS=BSDI Data Scientists=data_scientist,BSDI Reviewers=reviewer,BSDI GeoAI Admins=admin
ROLE_GROUPS=

# Role for a Portal user in none of the mapped groups. "labeler" can label
# and cannot start a GPU run - the safe default.
DEFAULT_PORTAL_ROLE=labeler

# Role a machine caller presenting API_KEY acts in. Narrow it to
# data_scientist or labeler if scripts should not administer users.
API_KEY_ROLE=admin


# -------------------------------------------------------------------------
# 3. MACHINE CALLERS  (deployment_config section 7)
# -------------------------------------------------------------------------

# Shared key for scripts and automation; humans use the login. Unset means
# one is generated per process, so automation breaks at every restart.
API_KEY=
API_KEY_HEADER=X-API-Key
# Set false only for a deliberately open dev run. summary() reports it.
AUTO_GENERATE_API_KEY=true


# -------------------------------------------------------------------------
# 4. NETWORK BINDING  (deployment_config SERVER, section 11)
# -------------------------------------------------------------------------

# Keep 127.0.0.1. IIS terminates TLS and proxies to loopback; the Python
# process is never directly reachable. Changing this exposes the app and
# turns on the fail-closed pre-flight checks in run_server.py.
HOST=127.0.0.1
PORT=8000

# Under IIS HttpPlatformHandler the port is assigned and arrives as
# HTTP_PLATFORM_PORT; run_server.py uses it automatically when PORT is
# unset.

# X-Forwarded-For is honoured only when the TCP peer is in this list.
# auth.py uses the client address for login throttling, so widening this
# lets a caller forge its source address and evade the lockout.
FORWARDED_ALLOW_IPS=127.0.0.1

# IIS ARR 3.0 cannot route compressed WebSocket frames. Set false behind
# ARR or /ws/training never connects and training progress stays blank.
WS_PER_MESSAGE_DEFLATE=true

# Origins allowed to make authenticated cross-origin calls. Must be the
# real published origin - "*" with credentials is the finding that was
# closed, and browsers reject that combination anyway.
# CORS_ALLOW_ORIGINS=https://geoai.bsdi.gov.bh
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true

# /docs, /redoc and /openapi.json publish every route and schema. Off in
# production.
ENABLE_API_DOCS=false


# -------------------------------------------------------------------------
# 5. DATA RESIDENCY - BASEMAPS  (deployment_config section 1)
# -------------------------------------------------------------------------

# THE 34:05 FINDING. Unset, the app falls back to a PUBLIC basemap and
# every pan and zoom over Bahrain is a request to a third party. Point this
# at the BSDI Image Server and imagery never leaves the IGA estate. The
# startup banner and the map toolbar both state which is in use.
# IGA_IMAGE_SERVER=https://images.bsdi.gov.bh/arcgis/rest/services/Orthophoto/MapServer
IGA_IMAGE_SERVER=
IGA_IMAGE_SERVER_NAME=BSDI Orthophoto (IGA)

# Set false once IGA_IMAGE_SERVER is configured: the public fallbacks are
# then not offered at all and cannot be selected by accident in a demo.
ALLOW_PUBLIC_BASEMAPS=true

# Place search is proxied through /api/geocode so search terms can be
# governed. Empty disables search (503). Point at an IGA geocoder for a
# governed deployment; the default sends search terms to OpenStreetMap.
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ArcGIS Image Service used for real training chips via exportImage.
# ARCGIS_IMAGE_SERVICE=https://images.bsdi.gov.bh/arcgis/rest/services/Orthophoto/ImageServer


# -------------------------------------------------------------------------
# 6. AIR GAP - PRE-TRAINED WEIGHTS  (deployment_config section 10)
# -------------------------------------------------------------------------

# False means the application never calls download.pytorch.org. Weights
# must be pre-staged; a missing one stops training with an error naming
# the file, instead of silently training from random initialisation.
# True adds download.pytorch.org to the outbound hosts the NCSC review
# must cover.
ALLOW_PRETRAINED_DOWNLOAD=false

# Pre-staged weight cache. Defaults to <app>/models/torch_home. Stage it on
# a connected machine with:
#   python stage_torch_weights.py          then copy the directory over
#   python stage_torch_weights.py --verify on this host
# TORCH_HOME=D:\BSDI\geoai\torch_home


# -------------------------------------------------------------------------
# 7. LICENSING  (deployment_config section 2)
# -------------------------------------------------------------------------

# ultralytics / YOLO is AGPL-3.0: network copyleft, which can oblige
# disclosure of this application's entire source to its users. This is a
# legal decision, not an environment variable. Leave false until IGA legal
# signs off or a commercial Ultralytics licence is held.
ENABLE_YOLO=false


# -------------------------------------------------------------------------
# 8. FILESYSTEM  (deployment_config sections 6 and 8)
# -------------------------------------------------------------------------

# Unpickling a checkpoint executes code. Weights-only by default; the
# full-object fallback is refused for uploads even when this is true.
ALLOW_UNSAFE_CHECKPOINT_LOAD=false

# Directories model export may write to, declared by an administrator.
# EXPORT_ROOTS=D:\BSDI\models

# Directories prediction may read source imagery from.
# EXTRA_READ_ROOTS=D:\BSDI\orthophotos


# -------------------------------------------------------------------------
# 9. .dlpk INTERCHANGE  (deployment_config section 12)
# -------------------------------------------------------------------------

# An imported .dlpk may contain a Python inference function - code ArcGIS
# executes at inference time. On import it is third-party code arriving in
# an uploaded archive, so it is listed in the import report but NOT written
# to disk. Enable only for a package whose source is known and whose
# inference function has been read.
DLPK_EXTRACT_INFERENCE_FUNCTION=false

# On export, trace the model to TorchScript and bundle it. This is what
# makes a package executable on an ArcGIS Image Server without the
# Braein.ai source tree. Local CPU operation; downloads nothing.
DLPK_INCLUDE_TORCHSCRIPT=true

# Zip-bomb limits, checked before extraction.
# DLPK_MAX_UPLOAD_BYTES=2147483648
# DLPK_MAX_EXTRACT_BYTES=4294967296
# DLPK_MAX_MEMBERS=512
