<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  Braein.ai - BSDI GeoAI Studio : IIS reverse proxy (ARR + URL Rewrite)
  ===========================================================================
  Copy this file to the PHYSICAL PATH OF THE IIS SITE, which must be an
  otherwise EMPTY folder (e.g. C:\inetpub\braein-proxy) - not the folder
  containing app.py. IIS then serves nothing from disk and proxies
  everything to the Python process on loopback. A site rooted on the
  application folder would be one mis-configured handler away from serving
  .env, users.json, app.py or a trained .pth over HTTP.

  Topology
  ........
      browser  ==HTTPS==>  IIS (TLS, auth logging, WAF)
                           |  http://127.0.0.1:8000
                           +==>  uvicorn / FastAPI  (HOST=127.0.0.1)

  The Python process stays on loopback. HOST in .env must remain 127.0.0.1;
  see DEPLOYMENT.md.

  Prerequisites on the server (DEPLOYMENT.md step 3)
  ........
    * URL Rewrite 2.1
    * Application Request Routing 3.0, with "Enable proxy" ticked at
      SERVER level (IIS Manager -> server node -> Application Request
      Routing Cache -> Server Proxy Settings)
    * WebSocket Protocol Windows feature INSTALLED AND ENABLED. Without it
      ARR cannot carry /ws/training or /ws, the training progress panel
      stays empty, and nothing in the log says why.
    * The app started with WS_PER_MESSAGE_DEFLATE=false. ARR 3.0 cannot
      route COMPRESSED WebSocket frames, and uvicorn negotiates
      permessage-deflate by default.
  ===========================================================================
-->
<configuration>
  <system.webServer>

    <!--
      WebSockets must be enabled for /ws/training and /ws to pass through.
      This is the site-level switch; the Windows feature must also be
      installed or this element is silently inert.
    -->
    <webSocket enabled="true" pingInterval="00:00:30" />

    <rewrite>
      <rules>
        <!--
          Single catch-all proxy rule. Everything - the UI, /login, the
          /static, /uploads, /chips and /outputs mounts, /api/*, and the
          WebSocket upgrade requests - goes to the application, which
          authenticates every one of them (app.py session middleware).

          Do NOT add rules that serve any path from the filesystem. The
          application's own authentication is the only access control on
          chips and model outputs; an IIS static-file shortcut would
          bypass it.
        -->
        <rule name="Braein.ai reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
          <serverVariables>
            <!--
              ARR already appends the caller's address to X-Forwarded-For.
              X-Forwarded-Proto is NOT set for you: without it the app
              cannot tell that the public hop was HTTPS. Both names must
              be whitelisted once per server in applicationHost.config
              (see DEPLOYMENT.md step 4) or IIS returns HTTP 500.19.
            -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>

      <!--
        No outbound rules, deliberately.

        An outbound rule that rewrites response headers can mangle
        Set-Cookie - and the session cookie IS the authentication
        mechanism here (auth.py). Rewriting its Domain or dropping it
        silently signs every user out at the first request. If one is ever
        added, exclude Set-Cookie from it explicitly and re-run the login
        test before go-live.
      -->
      <outboundRules />
    </rewrite>

    <!--
      Let the application's own error bodies through. By default IIS
      replaces the response body for any status >= 400 with its own error
      page, which would turn the app's JSON
      {"success": false, "error": "Not signed in", "login_url": "/login"}
      into an IIS 401 page and break the frontend's error handling.
    -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!--
          Orthophoto and model uploads are large. The IIS default is 30 MB,
          which fails an upload with a bare 404.13 long before the
          application sees it. 2 GB here; lower it to the largest file the
          workflow actually needs.
        -->
        <requestLimits maxAllowedContentLength="2147483648" />

        <!--
          Defence in depth. These should be unreachable anyway, because
          this site's physical path is an empty folder and every request is
          rewritten to the proxy. They exist so that pointing the site at
          the application folder by mistake does not publish the secrets.
        -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".pth" allowed="false" />
          <add fileExtension=".pt" allowed="false" />
          <add fileExtension=".orig" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="__pycache__" />
          <add segment="users.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!--
          IIS terminates TLS, so these are IIS's to set. HSTS is safe here
          because the deployment is HTTPS-only; drop it if the site is ever
          published on plain HTTP for a demo.
        -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <!--
          Server/version banners. Removing them is cosmetic against a real
          attacker and is still a standard hardening checklist item.
        -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
